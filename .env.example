# --- SEC EDGAR -------------------------------------------------------------
# SEC requires a descriptive User-Agent with a contact: "Your Name your@email.com"
SEC_USER_AGENT=sec-10k-agent your-contact@example.com

# --- LLM (LM Studio, OpenAI-compatible) -------------------------------------
LLM_BASE_URL=http://127.0.0.1:1234/v1   # not localhost (IPv6 fallback delay on Windows)
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=lm-studio
LLM_MAX_TOKENS=4000   # reasoning is off; keeps requests well inside qwen's 31k context
LLM_REASONING_EFFORT=none   # "none" = thinking off; empty = model default
# sampling, sent explicitly on every request (LM Studio honors all four)
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_TOP_K=20
LLM_MIN_P=0.0
LLM_REPEAT_PENALTY=1.0
EMBED_MODEL=text-embedding-bge-m3
EMBED_DIM=1024
# load bge-m3 explicitly at startup (a JIT load would evict qwen; a GUI load uses context 8192 = ~5 GB VRAM)
EMBED_AUTOLOAD=true
EMBED_GPU_OFFLOAD=off   # CPU. VRAM use is set by EMBED_CONTEXT even on CPU (8192 -> ~5 GB, 2048 -> ~0.7 GB)
EMBED_CONTEXT=2048
# one LM Studio call at a time; only needed if the embedding model can't stay loaded
LLM_SERIALIZE=false

# --- Infra (matches docker-compose.yml) -------------------------------------
POSTGRES_DSN=postgresql://sec:sec@localhost:5433/sec
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sec-agent-pw
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=sec-10k-agent
PREFECT_API_URL=http://localhost:4200/api
