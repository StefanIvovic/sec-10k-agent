# --- SEC EDGAR -------------------------------------------------------------
# SEC requires a descriptive User-Agent with a contact: "Your Name your@email.com"
SEC_USER_AGENT=sec-10k-agent your-contact@example.com

# --- Chat model: pick ONE block ---------------------------------------------
# LM Studio (tested: qwen3.8-27b)
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://127.0.0.1:1234/v1   # 127.0.0.1, not localhost (IPv6 fallback delay on Windows)
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=lm-studio
LLM_MAX_TOKENS=4000
LLM_REASONING_EFFORT=none   # "none" = qwen thinking off; empty = model default (thinking on, raise LLM_MAX_TOKENS)
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_TOP_K=20
LLM_MIN_P=0.0
LLM_REPEAT_PENALTY=1.0
LLM_SERIALIZE=false   # one LM Studio call at a time; only needed if the embedding model can't stay loaded

# Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_API_KEY=sk-ant-...
# LLM_EFFORT=medium   # low | medium | high | xhigh | max

# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=<model id>
# LLM_API_KEY=sk-...
# LLM_EFFORT=         # reasoning models: low | medium | high

# --- Embeddings: bge-m3 in LM Studio (always local) --------------------------
EMBED_BASE_URL=http://127.0.0.1:1234/v1
EMBED_MODEL=text-embedding-bge-m3
EMBED_DIM=1024
EMBED_AUTOLOAD=true     # load bge-m3 with the settings below at startup
EMBED_GPU_OFFLOAD=off   # off = CPU (no GPU needed), max = GPU
EMBED_CONTEXT=2048

# --- Infra (matches docker-compose.yml) -------------------------------------
POSTGRES_DSN=postgresql://sec:sec@localhost:5433/sec
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sec-agent-pw
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=sec-10k-agent
PREFECT_API_URL=http://localhost:4200/api
